      <Column Name="BookID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="ShoppingCart_CartItem" Member="ShoppingCart" ThisKey="cart_ID" OtherKey="cart_Id" Type="ShoppingCart" IsForeignKey="true" />
